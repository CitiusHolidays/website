{
  "name": "citius-travel-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ai:benchmark": "bun scripts/benchmark-ai-runtime.ts",
    "ai:config-check": "bun config/release/ai-runtime-config.ts",
    "assets:check": "bun config/release/check-public-assets.ts",
    "auth:schema:generate": "bunx @better-auth/cli generate --config ./convex/betterAuth/auth.ts --output ./convex/betterAuth/schema.ts",
    "automation:check": "bun config/release/agent-automation-policy.ts",
    "build": "bunx convex codegen --typecheck enable && next build",
    "check": "bun run lint && bun run lint:ratchet && bun run test",
    "check:fast": "bun run test",
    "ci:convex-key-check": "bun config/release/convex-ci-credentials.ts",
    "config:check": "bun run test -- config/release/release-contract.test.ts",
    "convex:codegen": "bunx convex codegen",
    "convex:dev": "bunx convex dev",
    "convex:typecheck": "cd convex && bunx tsc --noEmit",
    "dev": "bun --bun next dev --turbopack",
    "dev:all": "bun run convex:dev & bun run dev",
    "dev:reset": "rm -rf .next && bun run dev",
    "dev:webpack": "bun --bun next dev --webpack",
    "diff:check": "bun config/release/check-diff-hygiene.ts",
    "doctor": "npx react-doctor@latest",
    "env:preflight": "bun config/release/environment-preflight.ts",
    "format": "ultracite fix",
    "lint": "ultracite check",
    "lint:doctor": "ultracite doctor",
    "lint:fix": "ultracite fix",
    "lint:ratchet": "bun config/release/lint-ratchet.ts",
    "lint:ratchet:update": "bun config/release/lint-ratchet.ts --write-baseline",
    "optimize-images": "node scripts/full-optimize-images.mjs",
    "performance:check": "bun config/release/check-performance-budgets.ts",
    "policy:check": "bun config/release/check-ci-policy.ts",
    "smoke:browser": "bun scripts/browser-smoke.ts",
    "start": "next start",
    "test": "bun test --isolate --path-ignore-patterns='e2e/specs/**'",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test --grep @critical",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:workflow": "playwright test --grep @workflow",
    "test:local": "bun run test && bun run test:e2e",
    "typecheck": "next typegen && tsc --noEmit --project tsconfig.json"
  },
  "overrides": {
    "dompurify": "3.4.13",
    "mermaid": "11.16.1",
    "sharp": "0.35.3",
    "uuid": "11.1.1",
    "ws": "8.21.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@convex-dev/better-auth": "^0.12.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@portabletext/react": "^7.0.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.10",
    "@sanity/client": "^7.26.1",
    "@sanity/image-url": "^2.1.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-table": "^9.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.18",
    "better-auth": "1.6.23",
    "brace-expansion": "1.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.42.1",
    "effect": "^3.21.4",
    "exceljs": "^4.4.0",
    "isomorphic-dompurify": "^3.21.0",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "motion-plus": "^1.5.1",
    "next": "16.3.0",
    "razorpay": "^2.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.17.2",
    "sharp": "0.35.3",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "ultracite": "7.10.1"
  }
}
