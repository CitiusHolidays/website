{
  "name": "citius-travel-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ai:benchmark": "bun scripts/benchmark-ai-runtime.ts",
    "ai:config-check": "bun config/release/ai-runtime-config.ts",
    "ai:grounding-check": "bun scripts/benchmark-ai-grounding.ts",
    "assets:check": "bun config/release/check-public-assets.ts",
    "auth:schema:generate": "bunx @better-auth/cli generate --config ./convex/betterAuth/auth.ts --output ./convex/betterAuth/schema.ts",
    "automation:check": "bun config/release/agent-automation-policy.ts",
    "brand-assets:generate": "bun scripts/generate-public-brand-assets.ts",
    "browser:evidence:preview-public": "bun config/e2e/run-preview-public-evidence.ts",
    "build": "bunx convex codegen --typecheck enable && next build",
    "check": "bun run lint:all && bun run coverage:check && bun run test:convex",
    "check:fast": "bun run test",
    "config:check": "bun run test -- config/release/release-contract.test.ts",
    "convex:codegen": "bunx convex codegen",
    "convex:dev": "bunx convex dev",
    "convex:typecheck": "cd convex && bun ../node_modules/@typescript/native/bin/tsc --noEmit",
    "coverage:check": "bun config/release/coverage-ratchet.ts",
    "deadcode": "knip --config knip.jsonc --reporter compact",
    "deadcode:ratchet": "bun config/release/deadcode-ratchet.ts",
    "deadcode:ratchet:update": "bun config/release/deadcode-ratchet.ts --write-baseline",
    "dev": "next dev --turbopack",
    "dev:all": "bunx convex dev --start 'bun run dev'",
    "dev:doctor": "bun config/dev/doctor.ts",
    "dev:inspect": "CITIUS_REACT_INSPECTION=1 next dev --turbopack",
    "dev:reset": "rm -rf .next && bun run dev",
    "dev:webpack": "next dev --webpack",
    "diff:check": "bun config/release/check-diff-hygiene.ts",
    "docs:check": "bun config/commands/orientation.ts --check",
    "doctor": "react-doctor",
    "env:preflight": "bun config/release/environment-preflight.ts",
    "format": "ultracite fix",
    "help": "bun config/commands/manifest.ts",
    "lint": "ultracite check && bun run lint:anti-slop",
    "lint:all": "ultracite check --error-on-warnings && bun run lint:anti-slop && bun run lint:ratchet && bun run --cwd citius-blog lint",
    "lint:anti-slop": "bun node_modules/oxlint/bin/oxlint --config oxlint.config.ts .",
    "lint:doctor": "ultracite doctor",
    "lint:fix": "ultracite fix",
    "lint:ratchet": "bun config/release/lint-ratchet.ts",
    "lint:ratchet:update": "bun config/release/lint-ratchet.ts --write-baseline",
    "migration:rehearsal": "bun config/release/migration-rehearsal.ts",
    "optimize-images": "node scripts/full-optimize-images.mjs",
    "performance:backend:collect": "bun config/release/collect-staff-workspace-backend-cost.ts",
    "performance:backend:ingest": "bun config/release/ingest-staff-workspace-backend-cost.ts",
    "performance:check": "bun config/release/check-performance-budgets.ts",
    "performance:public:collect": "bun scripts/public-runtime-performance.ts",
    "performance:staff:collect": "bun config/e2e/run-authenticated-performance.ts",
    "precommit:check": "git diff --cached --check && bunx --no-install lint-staged",
    "prepare": "husky",
    "quality:target-neutral": "bun config/release/run-target-neutral-quality.ts",
    "release:scope": "bun config/release/summarize-change-range.ts",
    "repo:orient": "bun config/commands/orientation.ts",
    "smoke:browser": "bun scripts/browser-smoke.ts",
    "smoke:browser:authenticated": "bun scripts/browser-smoke.ts --profiles admin,sales,contracting,operations,ticketing,finance,hr --cases admin-dashboard,admin-team,sales-pipeline,sales-queries-pagination,contracting-proposals,operations-travellers,ticketing-list,finance-approvals,hr-leave --strict",
    "smoke:browser:public": "bun scripts/browser-smoke.ts --profiles public --cases public-home,public-home-mobile,pilgrimage,kailash-trail-mobile,sacred-bharat,staff-sign-in,account-redirect --strict",
    "spec:check": "bun config/spec/spec-check.ts",
    "spec:render-issue": "bun config/spec/render-issue.ts",
    "start": "next start",
    "test": "bun config/test/run-target-neutral-tests.ts",
    "test:bun": "bun test --isolate --max-concurrency=1 --path-ignore-patterns='e2e/specs/**' --path-ignore-patterns='e2e/public/**'",
    "test:convex": "vitest run --config vitest.convex.config.mts",
    "test:e2e": "E2E_STRICT=1 playwright test",
    "test:e2e:cleanup": "bun config/e2e/cleanup-run.ts",
    "test:e2e:critical": "E2E_STRICT=1 playwright test --grep @critical",
    "test:e2e:optional": "playwright test",
    "test:e2e:public-instant": "CITIUS_PLAYWRIGHT_PROFILE=public-instant playwright test",
    "test:e2e:smoke": "E2E_STRICT=1 playwright test --grep @smoke",
    "test:e2e:workflow": "E2E_STRICT=1 playwright test --grep @workflow",
    "test:local": "bun run test && bun run test:e2e",
    "typecheck": "next typegen && bun node_modules/@typescript/native/bin/tsc --noEmit --project tsconfig.json",
    "verify:local": "bun config/release/verify-local.ts"
  },
  "overrides": {
    "dompurify": "3.4.13",
    "mermaid": "11.16.1",
    "nanoid": "3.3.18",
    "sharp": "0.35.3",
    "uuid": "11.1.1",
    "ws": "8.21.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@convex-dev/aggregate": "^0.2.2",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/rate-limiter": "0.3.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@portabletext/react": "^7.0.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^2.1.1",
    "@silurus/ooxml": "0.80.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-table": "^9.1.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.66",
    "better-auth": "1.6.23",
    "brace-expansion": "1.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.44.0",
    "dompurify": "3.4.13",
    "effect": "4.0.0-rc.109",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.31.0",
    "motion": "13.1.0",
    "motion-plus": "^1.5.1",
    "next": "16.3.0",
    "pdfjs-dist": "6.2.108",
    "razorpay": "^2.9.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.20.0",
    "sharp": "0.35.3",
    "sonner": "^2.0.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@edge-runtime/vm": "^5.0.0",
    "@next/playwright": "16.3.0",
    "@oxlint/plugins": "1.78.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/bun": "^1.4.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "convex-test": "^0.0.55",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "knip": "6.32.2",
    "lint-staged": "17.3.0",
    "oxlint": "1.78.0",
    "react-doctor": "0.9.11",
    "react-grab": "0.1.50",
    "react-scan": "0.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "ultracite": "7.10.1",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0",
    "node": ">=22.12 <27"
  }
}
