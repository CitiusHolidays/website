    "databaseReadBytes": {
      "maxIncreaseFraction": 0.5,
      "minAbsoluteIncrease": 8192
    },
    "documentsRead": {
      "maxIncreaseFraction": 0.5,
      "minAbsoluteIncrease": 10
    },
    "executionMs": {
      "maxIncreaseFraction": 0.5,
      "minAbsoluteIncrease": 50
    },
    "occRetries": {
      "maxIncreaseFraction": 0,
      "minAbsoluteIncrease": 0
    }
  },
  "budgets": {
    "queries": {},
