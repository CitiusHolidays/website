{
  "schemaVersion": 3,
  "defaultBudget": {
    "cold": {
      "maxDatabaseIoReadBytes": 65536,
      "maxDatabaseReadBytes": 65536,
      "maxDocumentsRead": 80,
      "maxExecutionMs": 500,
      "maxOccRetries": 0
    },
    "warm": {
      "maxDatabaseIoReadBytes": 4096,
      "maxDatabaseReadBytes": 4096,
      "maxDocumentsRead": 4,
      "maxExecutionMs": 25,
      "maxOccRetries": 0
    }
  },
  "relativeRegression": {
    "databaseIoReadBytes": {
      "maxIncreaseFraction": 0.5,
