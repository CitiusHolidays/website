{
  "name": "blog",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "sanity"
  ],
  "license": "UNLICENSED",
  "main": "package.json",
  "scripts": {
    "build": "bun --bun sanity build",
    "build:production": "SANITY_DATASET=production bun --bun sanity build",
    "deploy": "SANITY_DATASET=production sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "bun --bun sanity dev",
    "start": "bun --bun sanity start"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  },
  "dependencies": {
    "@sanity/vision": "^4.22.0",
    "react": "^19.1",
    "react-dom": "^19.1",
    "sanity": "^4.22.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^5.0.2",
    "@types/react": "^19.1",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "typescript": "^5.8"
  }
}
